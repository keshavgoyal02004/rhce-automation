server {

    {% if hostname == 'node1' %}
    add_header X-Server-Type Primary;
    {% else %}
    add_header X-Server-Type Secondary;
    {% endif %}
    
    listen {{ http_port | default(80, true) }};
    server_name {{ inventory_hostname }};

    location / {
        default_type text/plain;
        return 200 "Hello from {{ inventory_hostname }} - {{ server_role | default('Unknown', true) }}";
    }
}

